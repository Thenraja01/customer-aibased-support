PORT=3030
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/supportai

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRES_IN=7d
JWT_ISSUER=supportai
JWT_AUDIENCE=supportai-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# OAuth Grant (for OAuth registration completion)
OAUTH_GRANT_TTL_MINUTES=15
EMAIL_VERIFY_TTL_MINUTES=30

# Redis (optional — leave empty for in-memory fallback)
REDIS_URL=

# Super Admin
SUPER_ADMIN_EMAIL=superadmin@supportai.com
SUPER_ADMIN_PASSWORD=Super@123
SUPER_ADMIN_NAME=SuperAdmin
SUPER_ADMIN_ROLE=super_admin
SUPER_ADMIN_ORG_ID=

# Client / Frontend URLs
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
LLM_MIN_RAG_SCORE=0.35
LLM_MAX_CONV_CHARS=3000
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# RAG Configuration
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_BFS_MAX_DEPTH=2
RAG_BFS_MAX_NODES=30
RAG_TOP_K=5
RAG_QUERY_CACHE_TTL_MS=600000

# Embedding
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_BASE_URL=http://localhost:11434

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=SupportAI <noreply@supportai.com>
OTP_EXPIRY_MINUTES=10

# Firebase Admin SDK — FCM HTTP v1 push notifications
# Paste the contents of your firebase-service-account.json as a single-line minified JSON string
FIREBASE_SERVICE_ACCOUNT=

# OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5173/oauth/facebook/callback
FACEBOOK_GRAPH_VERSION=v18.0

